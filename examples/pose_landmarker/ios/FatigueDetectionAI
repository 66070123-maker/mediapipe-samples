import cv2
import mediapipe as mp
import numpy as np
import pandas as pd
import time

# --- ตั้งค่า MediaPipe Pose ---
mp_pose = mp.solutions.pose
pose = mp_pose.Pose(min_detection_confidence=0.5, min_tracking_confidence=0.5)
mp_drawing = mp.solutions.drawing_utils

# --- ฟังก์ชันคำนวณมุม ---
def calculate_angle(a, b, c):
    a = np.array(a)
    b = np.array(b)
    c = np.array(c)
    radians = np.arctan2(c[1]-b[1], c[0]-b[0]) - np.arctan2(a[1]-b[1], a[0]-b[0])
    angle = np.abs(radians*180.0/np.pi)
    if angle > 180.0:
        angle = 360 - angle
    return angle

# --- สร้าง DataFrame เก็บข้อมูล ---
columns = ['Time', 'Left_Elbow_Angle', 'Fatigue_Flag']
df = pd.DataFrame(columns=columns)

# --- เปิดกล้อง ---
cap = cv2.VideoCapture(0)

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    image = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    image.flags.writeable = False
    results = pose.process(image)
    image.flags.writeable = True
    image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)

    try:
        landmarks = results.pose_landmarks.landmark

        # เลือกจุด Shoulder, Elbow, Wrist
        left_shoulder = [landmarks[mp_pose.PoseLandmark.LEFT_SHOULDER.value].x,
                         landmarks[mp_pose.PoseLandmark.LEFT_SHOULDER.value].y]
        left_elbow = [landmarks[mp_pose.PoseLandmark.LEFT_ELBOW.value].x,
                      landmarks[mp_pose.PoseLandmark.LEFT_ELBOW.value].y]
        left_wrist = [landmarks[mp_pose.PoseLandmark.LEFT_WRIST.value].x,
                      landmarks[mp_pose.PoseLandmark.LEFT_WRIST.value].y]

        # คำนวณมุมศอก
        angle = calculate_angle(left_shoulder, left_elbow, left_wrist)

        # แสดงมุมบนจอ
        cv2.putText(image, str(int(angle)),
                    tuple(np.multiply(left_elbow, [640, 480]).astype(int)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2, cv2.LINE_AA)

        # ตรวจจับความล้า (มุม < 30 องศา = ล้า)
        fatigue_flag = 1 if angle < 30 else 0
        if fatigue_flag == 1:
            cv2.putText(image, 'Fatigue Alert!', (50,50),
                        cv2.FONT_HERSHEY_SIMPLEX, 1, (0,0,255), 2, cv2.LINE_AA)

        # เก็บข้อมูลลง DataFrame
        df = df.append({'Time': time.time(),
                        'Left_Elbow_Angle': angle,
                        'Fatigue_Flag': fatigue_flag}, ignore_index=True)

    except:
        pass

    # วาด Skeleton
    if results.pose_landmarks:
        mp_drawing.draw_landmarks(image, results.pose_landmarks, mp_pose.POSE_CONNECTIONS)

    # แสดงผล
    cv2.imshow('Fatigue Detection', image)

    # กด 'q' เพื่อออก
    if cv2.waitKey(10) & 0xFF == ord('q'):
        break

# --- ปิดกล้องและบันทึก CSV ---
cap.release()
cv2.destroyAllWindows()
df.to_csv('fatigue_data.csv', index=False)
print("Data saved to fatigue_data.csv")
